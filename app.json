{
  "expo": {
    "name": "Paper & Pine",
    "slug": "paper-and-pine-library",
    "version": "1.0.0",
    "description": "A welcoming neighborhood library in your pocket.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "paperpine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.paperpine.library",
      "adaptiveIcon": {
        "backgroundColor": "#244B3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 210
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c5d816c-7fc1-4cf0-b996-e1523b2cbf99"
      }
    },
    "owner": "azi345"
  }
}
